# On-Device AI Reliability Monitor Environment Configuration
# All operations run strictly on local loopback (127.0.0.1)

# Backend Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Local AI Model Providers (Local Daemons Only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:1234/v1
DEFAULT_LLM_PROVIDER=mock

# Local Storage Paths
DATABASE_PATH=data/monitor.db
DATASETS_PATH=data/datasets
MODELS_CHECKPOINTS_PATH=models/checkpoints

# Camera & Audio Sampling Defaults
DEFAULT_CAMERA_FPS=2
DEFAULT_HYSTERESIS_WINDOW=5
DEFAULT_HYSTERESIS_THRESHOLD=3
DATA_RETENTION_DAYS=30
